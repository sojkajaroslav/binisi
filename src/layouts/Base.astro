---
import '../styles.css';
const { title = 'Lovely Binisi | Lagotto Romagnolo', description = 'Chovatelská stanice Lovely Binisi v jižních Čechách. Lagotto Romagnolo, naši psi a štěňata.' } = Astro.props;
const nav = [['/','Úvod'],['/o-nas/','O nás'],['/nasi-psi/','Naši psi'],['/stenata/','Štěňata'],['/kontakt/','Kontakt']];
const pathname = Astro.url.pathname;
---
<!doctype html><html lang="cs"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title}</title><link rel="icon" href="/images/logo.webp" type="image/webp"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet"/></head><body>
<a class="skip" href="#main">Přeskočit na obsah</a>
<header class="header"><div class="header-inner"><a class="brand" href="/" aria-label="Lovely Binisi – úvod"><img src="/images/logo.webp" alt="Lovely Binisi – Lagotto Romagnolo"/></a><button class="menu-toggle" aria-label="Otevřít nabídku" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button><nav id="main-nav" aria-label="Hlavní navigace">{nav.map(([href,label]) => <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>)}</nav></div></header>
<main id="main"><slot /></main>
<footer class="footer"><div class="wrap footer-grid"><div><a class="footer-brand" href="/">Lovely Binisi</a><p>Chovatelská stanice Lagotto Romagnolo<br/>Adamov u Českých Budějovic</p></div><div><span class="footer-label">Prozkoumejte</span>{nav.map(([href,label]) => <a href={href}>{label}</a>)}</div><div><span class="footer-label">Napište nám</span><a href="mailto:katerina.sojkova@gmail.com">katerina.sojkova@gmail.com</a><a href="tel:+420608306503">+420 608 306 503</a><div class="socials"><a href="https://www.instagram.com/lagotto_lovely_binisi/" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://www.facebook.com/lovely.binisi" target="_blank" rel="noopener noreferrer">Facebook ↗</a></div></div></div><div class="wrap footnote">© {new Date().getFullYear()} Lovely Binisi</div></footer>
<script>const btn=document.querySelector('.menu-toggle'); const nav=document.querySelector('#main-nav'); btn?.addEventListener('click',()=>{let open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));btn.setAttribute('aria-label',open?'Otevřít nabídku':'Zavřít nabídku');nav?.classList.toggle('open',!open)});</script>
</body></html>
