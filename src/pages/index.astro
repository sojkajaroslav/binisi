---
import Base from '../layouts/Base.astro';
import LinkIcon from '../components/LinkIcon.astro';
---
<Base title="Lagotto Romagnolo | Chovatelská stanice Lovely Binisi" description="Rodinná chovatelská stanice Lagotto Romagnolo v jižních Čechách. Zdraví, povaha, socializace, naši psi a štěňata Lovely Binisi."><section class="hero"><img src="/images/hero-nikita.webp" srcset="/images/hero-nikita-640.webp 640w, /images/hero-nikita.webp 867w" sizes="(max-width: 700px) 100vw, 55vw" width="867" height="927" fetchpriority="high" alt="Nikita před růžovými květy" class="hero-image"/><div class="hero-shade"></div><div class="wrap hero-inner"><div class="eyebrow light">CHOVATELSKÁ STANICE · JIŽNÍ ČECHY</div><h1>Psi jsou u nás<br/><em>doma</em></h1><p>Jsme Lovely Binisi, rodinná chovatelská stanice Lagotto Romagnolo. Naši psi s námi sdílejí každodenní život a štěňata vyrůstají v blízkém kontaktu s lidmi.</p><div class="hero-actions"><a href="/nasi-psi/" class="button button-light">Seznamte se s našimi psy <LinkIcon name="paw" /></a><a href="/o-nas/" class="text-link white">Náš příběh <LinkIcon name="paw" /></a></div></div><div class="hero-side">LOVELY BINISI · OD ROKU 2002</div></section>
<section class="intro section"><div class="wrap intro-grid"><div><div class="eyebrow">VÍTEJTE U NÁS</div><h2>Malá stanice<br/><em>Velká psí rodina</em></h2></div><div class="intro-copy"><p>Se psy žijeme už více než 25 let. Chovatelskou stanici jsme založili v roce 2002 a dnes patří naše srdce především lagottům. Žijeme v jižních Čechách, v domě se zahradou, kde jsou psi součástí rodiny.</p><a href="/o-nas/" class="text-link">Přečíst náš příběh <LinkIcon name="paw" /></a></div></div></section>
<section class="home-moments section" aria-label="Ze života naší smečky"><div class="wrap"><div class="eyebrow">KAŽDÝ DEN SPOLU</div><h2>Život s <em>našimi psy</em></h2><div class="home-moments-grid"><img src="/images/home-city.webp" width="800" height="1000" alt="Hnědý Lagotto Romagnolo před historickou budovou" loading="lazy" decoding="async"/><img src="/images/home-door.webp" width="800" height="1186" alt="Bílohnědý Lagotto Romagnolo před červenými dveřmi" loading="lazy" decoding="async"/><img src="/images/home-puppies.webp" width="900" height="900" alt="Dvě štěňata Lagotto Romagnolo vedle sebe" loading="lazy" decoding="async"/></div></div></section>
<section class="feature section"><div class="wrap"><div class="section-head"><div><div class="eyebrow">NAŠE SMEČKA</div><h2>Každý z nich má<br/><em>svůj příběh</em></h2><p class="home-pack-lead">Poznejte Nikitu, Luka, Tatu a Rinu – čtyři osobnosti, díky nimž je náš domov plný života.</p></div><a href="/nasi-psi/" class="text-link">Poznat všechny psy <LinkIcon name="paw" /></a></div><div class="feature-grid"><a href="/nasi-psi/" class="photo-card large"><img src="/images/nikita.webp" srcset="/images/nikita-600.webp 600w, /images/nikita.webp 675w" sizes="(max-width: 700px) 100vw, 50vw" width="675" height="900" alt="Jonia Nikita ze Sulické tvrze" loading="lazy"/><span class="photo-overlay"><small>NAŠI PSI</small><strong>Jonia Nikita</strong><span>Seznamte se <LinkIcon name="paw" /></span></span></a><a href="/nasi-psi/" class="photo-card"><img src="/images/luke.webp" srcset="/images/luke-600.webp 600w, /images/luke.webp 900w" sizes="(max-width: 700px) 100vw, 42vw" width="900" height="758" alt="Il Granaio dei Malatesta Luke Perry" loading="lazy"/><span class="photo-overlay"><small>NAŠI PSI</small><strong>Luke Perry</strong><span>Seznamte se <LinkIcon name="paw" /></span></span></a></div></div></section>
<section class="values section"><div class="wrap"><div class="eyebrow">NA ČEM NÁM ZÁLEŽÍ</div><div class="value-grid"><div><h3>Zdraví</h3><p>Chovné psy testujeme na dědičná onemocnění i nad rámec testů požadovaných chovatelským klubem.</p></div><div><h3>Povaha</h3><p>Stejnou pozornost jako zdraví věnujeme povaze. Štěňata od narození poznávají každodenní život naší domácnosti.</p></div><div><h3>Kontakt</h3><p>S majiteli našich odchovů zůstáváme v kontaktu a rádi poradíme s péčí, výchovou i chovem.</p></div></div></div></section>
<section class="home-truffles section"><div class="wrap home-truffles-grid"><div><div class="eyebrow">SPOLEČNÁ PRÁCE</div><h2>Hledání lanýžů <em>nás baví</em></h2><p>S našimi psy se věnujeme hledání lanýžů. Při tréninku rozvíjíme jejich přirozené vlohy a užíváme si společnou práci. Své zkušenosti sdílíme i dál: pořádáme klubové tréninky hledání lanýžů a těší nás, jak si práci užívají psi i jejich lidé.</p></div><img src="/images/home-forest.webp" width="900" height="1350" alt="Lagotto Romagnolo v lese" loading="lazy" decoding="async"/></div></section>
<section class="puppy-banner"><div class="wrap puppy-grid"><div class="puppy-photo"><img src="/images/puppies.jpg" alt="Štěňata Lovely Binisi" loading="lazy"/></div><div class="puppy-copy"><div class="eyebrow">ŠTĚŇATA LOVELY BINISI</div><h2>Malé tlapky,<br/><em>velké začátky</em></h2><p>Štěňata u nás vyrůstají doma, mezi lidmi a při běžném chodu domácnosti. Podívejte se, jak vypadají jejich první týdny u Lovely Binisi.</p><a class="button button-dark" href="/stenata/">Naše štěňata <LinkIcon name="paw" /></a></div></div></section>
<section class="contact-strip"><div class="wrap strip-inner"><div><div class="eyebrow">ZŮSTAŇME V KONTAKTU</div><h2>Rádi vás poznáme</h2><p class="home-contact-lead">Zajímá vás naše smečka nebo život se štěnětem Lagotto Romagnolo? Napište nám.</p></div><a href="/kontakt/" class="button button-outline">Napište nám <LinkIcon name="paw" /></a></div></section></Base>
