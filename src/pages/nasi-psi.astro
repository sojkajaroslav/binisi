---
import Base from '../layouts/Base.astro';
const dogs=[
{name:'Jonia Nikita ze Sulické tvrze',birth:'5. 6. 2022',color:'Hnědá',image:'nikita.webp',breeder:'Stanislava Janická (ČR)',awards:'Junioršampion ČR a Rakouska · Mezinárodní junioršampion · Český šampion a grandšampion',tests:'DKK A · DLK 0/0 · patella 0/0 · LSD negativní · JE carrier · PRA-prcd negativní · HUU negativní',pedigree:'https://lagotto.breedarchive.com/animal/view/jonia-nikita-ze-sulicke-tvrze-64db1436-6d92-4ff6-9232-da781b5e073f'},
{name:'Il Granaio dei Malatesta Luke Perry',birth:'16. 12. 2022',color:'Bílohnědá s pálením',image:'luke.webp',breeder:'Monica Benelli (Itálie)',awards:'Junioršampion ČR a Rakouska · Mezinárodní junioršampion · Kvalifikace na Cruft’s 2024',tests:'DKK A · DLK 0/0 · OCD negativní · patella 0/0 · JE, LSD, PRA-prcd a HUU negativní',pedigree:'https://lagotto.breedarchive.com/animal/view/il-granaio-dei-malatesta-luke-perry-d3724958-004e-493e-bbca-b3bd22ac0537'},
{name:'Il Granaio dei Malatesta Tata Escobar',birth:'24. 6. 2023',color:'Oranžová',image:'tata.webp',breeder:'Monica Benelli (Itálie)',awards:'',tests:'DKK B · DLK 0/0 · OCD negativní · patella 0/0 · LSD negativní · JE carrier · PRA-prcd a HUU negativní',pedigree:'https://lagotto.breedarchive.com/animal/view/il-granaio-dei-malatesta-tata-escobar-35cace7d-ae9d-4b9f-b1af-d55b8b351b02'},
{name:'Il Granaio dei Malatesta Rina',birth:'19. 3. 2025',color:'Hnědý roan',image:'rina.webp',breeder:'Monica Benelli (Itálie)',awards:'',tests:'JE, LSD, PRA-prcd a HUU negativní · Furnishing F/F · Curly C/C',pedigree:'https://lagotto.breedarchive.com/animal/view/il-granaio-dei-malatesta-rina-5b0c3451-61a7-4a99-93d8-2ac00162d03e'}
];
---
<Base title="Naši psi | Lovely Binisi"><section class="page-hero"><div class="wrap"><div class="eyebrow">SEZNAMTE SE S NAŠÍ SMEČKOU</div><h1>Naši psi<span class="accent">.</span></h1><p>Čtyři osobnosti, které s námi sdílejí každý den.</p></div></section><section class="section"><div class="wrap dog-list">{dogs.map((dog,i)=><article class="dog-row"><div class="dog-image"><img src={`/images/${dog.image}`} alt={dog.name} loading={i===0?'eager':'lazy'}/></div><div class="dog-info"><span class="eyebrow">{String(i+1).padStart(2,'0')} / LAGOTTO ROMAGNOLO</span><h2>{dog.name}</h2><div class="dog-facts"><span>Narození <b>{dog.birth}</b></span><span>Barva <b>{dog.color}</b></span><span>Chovatel <b>{dog.breeder}</b></span></div>{dog.awards&&<p class="awards">{dog.awards}</p>}<h3>Zdravotní testy</h3><p>{dog.tests}</p><a class="text-link" href={dog.pedigree} target="_blank" rel="noopener noreferrer">Prohlédnout rodokmen <span>↗</span></a></div></article>)}</div></section></Base>
