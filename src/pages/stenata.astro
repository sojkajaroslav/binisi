---
import Base from '../layouts/Base.astro';
const litters=[{name:'Vrh C · Ciao',date:'11. 11. 2025',description:'Narodilo se nám 5 štěňátek: 2 pejsci a 3 fenky.'},{name:'Vrh B · Bella',date:'19. 2. 2025',description:'Fionce se narodilo 7 štěňátek: 5 pejsků a 2 fenky.'},{name:'Vrh A · Aqua',date:'27. 9. 2024',description:'Nikitce se narodilo 6 štěňátek: 3 pejsci a 3 fenky.'}];
---
<Base title="Štěňata | Lovely Binisi"><section class="page-hero"><div class="wrap"><div class="eyebrow">NAŠE ODCHOVY</div><h1>Štěňata<span class="accent">.</span></h1><p>Od prvních dnů vyrůstají v blízkosti lidí a v rytmu běžného domácího života.</p></div></section><section class="section"><div class="wrap litters-grid"><div class="litters-intro"><div class="eyebrow">NAŠE VRHY</div><h2>První kroky<br/><em>začínají doma.</em></h2><p>Povaha a socializace štěňat jsou pro nás stejně důležité jako zdraví. O další informace o štěňatech nám můžete napsat.</p><a class="text-link" href="/kontakt/">Kontaktovat nás <span>↗</span></a></div><div class="litters-list">{litters.map(l=><article class="litter"><span class="eyebrow">{l.date}</span><h3>{l.name}</h3><p>{l.description}</p></article>)}</div></div></section><section class="wide-photo puppies-wide"><img src="/images/puppies.jpg" alt="Štěňata Lovely Binisi" loading="lazy"/></section></Base>
